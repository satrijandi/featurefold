# Analysis surface: reads the published marts directly, either from the local
# DuckDB file or from Parquet on SeaweedFS via the S3 API.
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      jupyterlab==4.3.4 \
      duckdb==1.1.3 \
      pandas==2.2.3 \
      pyarrow==18.1.0 \
      matplotlib==3.9.4 \
      boto3==1.35.90 \
      pyyaml==6.0.2

WORKDIR /opt/featurefold/showcase
EXPOSE 8888
