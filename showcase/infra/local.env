# Throwaway secrets for the LOCAL stack only. Never used anywhere else.
#
# This is the single place the local stack reads secrets from: the showcase
# Makefile loads it for the tools, docker compose interpolates it into the
# containers and into Airflow's `fs_object_store` Connection. No code and no
# compose default falls back to these values; a deployment supplies its own
# through its secret store.

# --- object store: the identity infra/seaweed/s3.json configures -------------
#
# S3_ENDPOINT is the host-side address. Containers reach the store at
# seaweedfs:8333 instead, which docker compose sets for them.
S3_ENDPOINT=localhost:8433
S3_ACCESS_KEY=featurefold
S3_SECRET_KEY=featurefold

# --- Airflow ------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_DB_PASSWORD=airflow
# Encrypts connection passwords and variables in the metadata database.
AIRFLOW_FERNET_KEY=m_4CPJnrv5pI2OTkuzu0KenfRb_3nBQVLGM4DMEHLNw=
# Shared by the webserver and the scheduler, so the UI can fetch task logs.
AIRFLOW_WEBSERVER_SECRET_KEY=e9c09dd2478c6200186019d92d5ab3c10695f9aa8cd2d943
